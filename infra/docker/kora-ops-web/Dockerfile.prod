# Dockerfile production pour KORA OPS Web
# Image unique PHP-FPM avec build frontend (Wayfinder necessite PHP pendant le build Vite)

FROM php:8.4-fpm-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    libicu-dev \
    libpq-dev \
    libzip-dev \
    unzip \
    git \
    && docker-php-ext-install \
    bcmath \
    exif \
    intl \
    opcache \
    pdo_pgsql \
    zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Installer Node 22 (necessaire pour le build Vite)
COPY --from=node:22-bookworm-slim /usr/local/bin /usr/local/bin
COPY --from=node:22-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules

WORKDIR /app

# Installer les dependances PHP (sans scripts car artisan n'est pas encore disponible)
COPY apps/kora-ops-web/composer.json apps/kora-ops-web/composer.lock ./
RUN composer install --no-dev --no-interaction --optimize-autoloader --no-cache --no-scripts

# Installer les dependances frontend
COPY apps/kora-ops-web/package.json apps/kora-ops-web/package-lock.json ./
RUN npm ci

# Copier le code source
COPY apps/kora-ops-web/ ./

# Preparer Laravel pour le build
RUN mkdir -p storage/app/private storage/app/public storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && cp .env.example .env && php artisan key:generate

# Build frontend (Wayfinder necessite PHP + artisan)
RUN php artisan wayfinder:generate --with-form && npm run build

# Nettoyer Node (non necessaire en production)
RUN rm -rf node_modules

# Permissions Laravel
RUN mkdir -p /app/storage/app/private /app/storage/app/public /app/storage/framework/cache/data /app/storage/framework/sessions /app/storage/framework/views /app/storage/logs \
    && chown -R www-data:www-data /app/storage /app/bootstrap/cache \
    && chmod -R 775 /app/storage /app/bootstrap/cache

# Optimisations production
RUN php artisan config:clear \
    && php artisan route:clear \
    && php artisan view:clear

EXPOSE 9000

CMD ["php-fpm"]
