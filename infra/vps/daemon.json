{
    "builder": {
        "gc": {
            "enabled": true,
            "defaultKeepStorage": "8GB",
            "policy": [
                { "keepStorage": "8GB", "all": true },
                { "keepStorage": "4GB", "filter": ["unused-for=168h"] }
            ]
        }
    },
    "log-driver": "json-file",
    "log-opts": {
        "max-size": "20m",
        "max-file": "3"
    }
}
