  "api": {
    "openapi": "api/openapi.yaml",
    "mdx": {
      "server": [
        "https://staging.koraexpress.app",
        "https://prod.koraexpress.app"
      ],
      "auth": {
        "method": "bearer"
      }
    },
    "playground": {
      "display": "interactive"
    },
    "url": "full",
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "typescript",
        "dart"
      ],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
