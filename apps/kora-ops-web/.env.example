APP_NAME="KORA Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Docker (staging/production): set LOG_STACK=docker for daily file + stderr
# so application logs are visible via `docker logs`.
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# KORA service identity (exposed by /api/v1/health)
KORA_SERVICE_NAME=kora-platform
KORA_SCOPE=mvp-bus
KORA_API_VERSION=v1
KORA_QUOTE_TTL_MINUTES=10
KORA_HOLD_TTL_MINUTES=15
KORA_SALE_CUTOFF_MINUTES=30
KORA_STALE_DEPARTURE_HOURS=24
KORA_MAX_DEPARTURE_DELAY_MINUTES=720

# Ticket QR code signing key (HMAC-SHA256). Generate with: php artisan key:generate-ticket-signing-key
# Must be 32+ characters and shared with the KORA P501 boarding app for offline QR verification.
KORA_TICKET_SIGNING_KEY=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=kora
DB_USERNAME=kora
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
KORA_QUOTE_TTL_MINUTES=10

# OAuth Social Providers (KORA App Passenger)
# Le client_id est public (intégré côté mobile), le secret reste backend.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=/api/v1/auth/oauth/google/callback

# Fournisseur cartographique (lignes/arrêts) : openstreetmap (défaut, gratuit,
# sans clé) ou google (nécessite MAP_GOOGLE_MAPS_API_KEY + facturation Google).
# Peut être surchargé à chaud par un admin via /network/map-settings.
MAP_PROVIDER=openstreetmap
MAP_GOOGLE_MAPS_API_KEY=

FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT=/api/v1/auth/oauth/facebook/callback

TIKTOK_OAUTH_CLIENT_ID=
TIKTOK_OAUTH_CLIENT_SECRET=

TIKTOK_OAUTH_REDIRECT=/api/v1/auth/oauth/tiktok/callback

# ──────────────────────────────────────────────────────────────────────────────
# Payment Providers
# ──────────────────────────────────────────────────────────────────────────────

PAYMENT_DEFAULT_PROVIDER=fedapay
PAYMENT_TIMEOUT_MINUTES=15

# FedaPay
FEDAPAY_ENABLED=false
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_CURRENCY=XOF
FEDAPAY_PHONE_COUNTRY=bj
FEDAPAY_MODE_MTN_MOMO=mtn
FEDAPAY_MODE_MOOV_FLOOZ=moov
FEDAPAY_MODE_CELTIIS_CASH=celtiis
FEDAPAY_CALLBACK_URL=
FEDAPAY_WEBHOOK_SECRET=

# MTN MoMo (Collection API)
MTN_MOMO_ENABLED=false
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_API_KEY=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=
MTN_MOMO_TARGET_ENVIRONMENT=mtnbenin
# Devise imposée par le sandbox MTN. En production, utiliser la devise du compte provisionné.
MTN_MOMO_SANDBOX_CURRENCY=EUR
MTN_MOMO_PRODUCTION_CURRENCY=XOF
MTN_MOMO_WEBHOOK_SECRET=

# Browsershot (PDF generation via Chromium)
# Local dev: path to puppeteer's Chromium (check ~/.cache/puppeteer/chrome/*/chrome-linux64/chrome)
# Docker prod: leave empty to use system chromium (/usr/bin/chromium)
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_BINARY=/usr/bin/node

# Sessions OPS Mobile (MEZ-95) — liaison convoyeur / terminal P501
# Fenêtre d'une session (renouvelable), durée absolue depuis l'ouverture, et
# intervalle minimal entre deux mises à jour de last_seen_at.
OPS_SESSION_TTL_MINUTES=720
OPS_SESSION_MAX_LIFETIME_MINUTES=1440
OPS_SESSION_TOUCH_INTERVAL_SECONDS=60

# Alertes opérationnelles boarding (MEZ-96) — e-mail des alertes (terminal révoqué,
# conflit de scan, opérations rejetées, synchronisation échouée, erreur d'impression) :
# directeurs des opérations de l'agence du convoyeur en destinataires, super-admins en copie.
# Nécessite un worker de file (php artisan queue:work) et un MAIL_MAILER réel.
OPS_NOTIFICATION_MAIL_ENABLED=true
OPS_NOTIFICATION_MAIL_TRIES=3
OPS_NOTIFICATION_MANIFEST_DEBOUNCE_SECONDS=120
