<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Caméra : scan des billets QR sur l'écran Scan boarding
         (mobile_scanner) — voir document.md § Scan boarding. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- Réseau : appels API (Dio/NetworkClient) et détection de connexion
         pour l'indicateur de synchro. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Suivi de position du convoyeur (MEZ-101) — service premier plan,
         écran verrouillé et app en arrière-plan compris. FINE/COARSE :
         requises par geolocator. BACKGROUND_LOCATION : Android 10+, sans
         quoi le flux de position s'arrête dès que l'app quitte le premier
         plan — demandée séparément, après FINE (voir
         TrackingRepositoryImpl.checkAvailability, flux Android recommandé
         par Google). FOREGROUND_SERVICE(_LOCATION) : requis Android 9+/14+
         pour démarrer et déclarer le type du service (voir <service>
         ci-dessous). POST_NOTIFICATIONS : Android 13+, notification
         persistante obligatoire pendant le suivi. WAKE_LOCK : le CPU doit
         rester actif pour mesurer la position écran éteint (voir
         allowWakeLock dans TrackingRepositoryImpl.init). REQUEST_IGNORE_
         BATTERY_OPTIMIZATIONS : proposer au convoyeur de désactiver
         l'optimisation batterie pour KORA OPS, sans quoi certains
         constructeurs (Xiaomi, Huawei...) tuent le service en arrière-plan
         malgré le premier plan. RECEIVE_BOOT_COMPLETED : reprise
         automatique du suivi si le terminal redémarre en cours de route. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>

    <!-- Mise à jour hors store (MEZ-150) : l'app n'est pas distribuée sur le
         Play Store, elle installe elle-même l'APK téléchargé depuis KORA OPS
         Web (Android 8+ : l'utilisateur doit autoriser KORA OPS à installer
         des applications, voir ApkInstallerChannel). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="KORA OPS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Canal FCM par défaut (créé dans PushNotificationService). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="kora_ops_alerts"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Service premier plan du suivi de position (MEZ-101) —
             flutter_foreground_task. `foregroundServiceType="location"`
             requis Android 14+ (voir FOREGROUND_SERVICE_LOCATION
             ci-dessus) ; `stopWithTask="false"` volontaire : le suivi doit
             survivre à une fermeture accidentelle de l'app tant que le
             convoyeur n'a pas confirmé l'arrivée, seul TrackingRepository
             (arrivée/annulation/déconnexion) l'arrête. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:stopWithTask="false"
            android:exported="false"/>

        <!-- Partage de l'APK téléchargé avec l'installeur système (MEZ-150).
             Autorité propre à KORA OPS, distincte de celles des plugins. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apk_installer"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/apk_installer_paths"/>
        </provider>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
