<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.koraexpress.passenger">
    <!-- Écran « Autorisations » : suivi du bus en direct et points KORA
         proches. La position approchée suffit à la plupart des écrans,
         mais le suivi du véhicule demande la position précise. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Billet, rappels et alertes de trajet. Obligatoire depuis
         Android 13 : sans elle, aucune notification n'est affichée. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Indispensable en release. Le template Flutter ne la déclare que
         dans les manifests debug/ et profile/, qui ne sont pas fusionnés
         dans un build release : l'APK s'installe et s'ouvre, mais ne
         joint jamais l'API. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Facebook SDK : l'application n'utilise pas l'Advertising ID -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>
    <!-- `open_filex` déclare l'accès aux photos, vidéos, sons et au
         stockage partagé. L'app n'ouvre que ses propres billets PDF, rangés
         dans son espace privé et transmis par FileProvider : aucune de ces
         permissions ne lui sert, et le Play Store exige de justifier les
         permissions média. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>

    <application
        android:label="KORA Passenger"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Canal par défaut des notifications push.
             Sans cette méta-donnée, Firebase retombe sur son canal de
             secours, qui s'affiche sans nom dans les réglages du
             téléphone et arrive en silence sur certains appareils.
             L'identifiant doit correspondre à celui que MainActivity
             crée au démarrage. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="kora_voyages" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Connexion Facebook. Seules ces valeurs manquent au SDK : il
             déclare lui-même FacebookActivity, CustomTabActivity (avec
             son intent-filter fbconnect://cct.<applicationId>) et le
             provider qui l'initialise au démarrage. Elles viennent de
             android/facebook.properties via resValue (build.gradle.kts). -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />
        <!-- Facebook ne sert ici qu'à la connexion : on coupe la
             télémétrie automatique, qui partirait sinon à chaque
             ouverture de l'app, et la collecte de l'identifiant
             publicitaire, dont on n'a aucun usage. -->
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- « Ouvrir le billet » : depuis Android 11, sans cette
             déclaration, les lecteurs PDF sont invisibles pour l'app et
             l'ouverture répond qu'aucune application ne sait le faire. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="application/pdf"/>
        </intent>
    </queries>
</manifest>
